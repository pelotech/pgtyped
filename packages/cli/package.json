{
  "name": "@pelotech/pgtyped-cli",
  "version": "2.4.3",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./pglite": {
      "types": "./lib/db/pglite.d.ts",
      "import": "./lib/db/pglite.js"
    },
    "./*": "./lib/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pelotech/pgtyped.git"
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://github.com/pelotech/pgtyped",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "check": "tsc --noEmit",
    "check:test": "tsc -p tsconfig.test.json",
    "watch": "tsc --watch --preserveWatchOutput"
  },
  "bin": {
    "pgtyped": "lib/cli.js"
  },
  "dependencies": {
    "@pelotech/pgtyped-runtime": "workspace:^",
    "change-case": "^5.4.4",
    "chokidar": "^5.0.0",
    "debug": "^4.1.1",
    "fs-extra": "^11.4.0",
    "glob": "^13.0.6",
    "minimatch": "^10.0.1",
    "nunjucks": "3.2.4",
    "pg": "catalog:",
    "ts-parse-database-url": "^1.0.3",
    "yargs": "^18.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/debug": "^4.1.13",
    "@types/fs-extra": "11.0.4",
    "@types/node": "catalog:",
    "@types/nunjucks": "^3.1.3",
    "@types/pg": "catalog:",
    "@types/yargs": "^17.0.35",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.5 <1",
    "typescript": ">=5 <7"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
