{
  "transforms": [
    {
      "mode": "sql",
      "include": "**/*.sql",
      "emitTemplate": "{{dir}}/{{name}}.queries.ts"
    },
    {
      "mode": "ts",
      "include": "**/*.ts",
      "emitTemplate": "{{dir}}/{{name}}.types.ts"
    }
  ],
  "typesOverrides": {
    "date": {
      "return": "string"
    },
    "int8": "BigInt",
    "category": { "return": "./src/customTypes.js#Category" },
    "email_address": "./src/customTypes.js#EmailAddress"
  },
  "srcDir": "./src/",
  "dbUrl": "postgres://postgres:password@localhost/postgres"
}
