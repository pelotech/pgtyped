{
  "name": "pgtyped",
  "version": "0.0.1",
  "main": "index.js",
  "author": "Adel Salakh",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "clean": "rm -r packages/*/lib",
    "build": "pnpm -r run build",
    "watch": "pnpm -r --parallel run watch",
    "lint": "eslint . && prettier --check .",
    "lint!": "eslint . --fix && prettier --write .",
    "test": "pnpm run lint && pnpm -r run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "typescript": "catalog:",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
